# Base URL the browser uses for API calls. "/api" works in dev through the Vite proxy.
# For a deployed build use the full API URL, e.g. https://api.example.com/api
# (then the backend CORS policy must allow the frontend origin).
VITE_API_BASE_URL=/api

# Where the Vite dev server forwards /api (dev only). Matches launchSettings "https" profile.
VITE_DEV_PROXY_TARGET=https://localhost:7107
